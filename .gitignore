# ── Secrets / config (NEVER commit) ──────────────────────────────
wrench_config.json
.env
.env.*
**/.env
**/.env.*
wrench_deploy/.env*
*.flag

# ── Databases & backups (large / regenerable) ────────────────────
*.db
*.db-shm
*.db-wal
*.db.*
*.bak
*.bak*
db_backups/

# ── Build outputs served from wrench_deploy/ are intentionally tracked
#    (Vercel deploys from git), but the stale root demo copy is not needed.
wrench_deploy/wrench_demo.html

# ── Quarantined unsafe one-shot import scripts (see folder README) ─
_archive_unsafe_imports/

# ── Logs ─────────────────────────────────────────────────────────
*.log

# ── Tooling / build artifacts ────────────────────────────────────
wrench-repomix.xml
.vercel
.vercel/
__pycache__/
*.pyc
*.pyo

# ── Installers / binaries (not source) ───────────────────────────
*.exe
*.msi
*.msix
*.zip
*.7z
*.dmg

# ── API response caches (large, regenerable) ─────────────────────
*_cache.json
complaints_api_cache.json

# ── Node deps (never commit) ─────────────────────────────────────
node_modules/
**/node_modules/

# ── Claude Code local state (machine-specific) ───────────────────
.claude/settings.local.json
.claude/*.lock

# ── OS cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# Cloned OSS datasets (third-party, regenerable)
oss_import/

# transient caches / test scripts
nhtsa_safety_cache.json
_drainbolt_verify.py
_vf_raw.json
