wrench-repomix.xml
.vercel
.vercel/
__pycache__/
*.pyc
*.pyo

# ── Installers / binaries (not source) ───────────────────────────
*.exe
*.msi
*.msix
*.zip
*.7z
*.dmg

# ── API response caches (large, regenerable) ─────────────────────
*_cache.json
complaints_api_cache.json

# ── Node deps (never commit) ─────────────────────────────────────
node_modules/
**/node_modules/

# ── Claude Code local state (machine-specific) ───────────────────
.claude/settings.local.json
.claude/*.lock

# ── CLAUDE.md project context ────────────────────────────────────
#    Root CLAUDE.md is COMMITTED (shared, sanitized methodology). Scoped +
#    local files stay untracked (internal process / sensitive ops notes).
wrench_deploy/CLAUDE.md
files/CLAUDE.md
CLAUDE.local.md
.claude.local.md

# ── OS cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# Cloned OSS datasets (third-party, regenerable)
oss_import/

# transient caches / test scripts
nhtsa_safety_cache.json
_drainbolt_verify.py
_vf_raw.json

# Subaru OMs exceed GitHub 100MB limit - kept locally, not committed
_subaru_outback_*_om.pdf

