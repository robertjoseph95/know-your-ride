# ── Secrets / config (NEVER commit) ──────────────────────────────
wrench_config.json
.env
.env.*
**/.env
**/.env.*
wrench_deploy/.env*
*.flag

# ── Databases & backups (large / regenerable) ────────────────────
*.db
*.db-shm
*.db-wal
*.db.*
*.bak
*.bak*
db_backups/

